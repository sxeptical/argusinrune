# Argus reads these with dotenvy from a `.env` in the working directory, or
# from process environment variables. Process env wins over `.env`, which wins
# over the optional TOML file at ~/.config/argus/config.toml (ARGUS_CONFIG_FILE).
# A missing or "your_..." placeholder value simply marks that source
# "unconfigured" — the app still runs and shows the other feeds.

# LTA DataMall key: bus stops/arrivals, cameras, incidents, carparks, EV, alerts.
LTA_API_KEY=your_lta_datamall_key

# AviationStack key: live flights around Singapore (falls back to OpenSky).
AVIATIONSTACK_API_KEY=your_aviationstack_key

# Optional: Neon Postgres connection string for the visitor feedback form.
# Create the table once with: psql "$DATABASE_URL" -f scripts/sql/feedback.sql
# Without it the feedback form reports that storage is not configured.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: static JSON bundle directory (default: <repo>/data).
#ARGUS_DATA_DIR=/path/to/argus/data

# Optional: local preferences / config file overrides.
#ARGUS_CONFIG_DIR=/path/to/config/dir          # default ~/.config/argus
#ARGUS_CONFIG_FILE=/path/to/config.toml        # default ~/.config/argus/config.toml

# Optional: basemap tile disk cache (default: platform cache dir).
#ARGUS_CACHE_DIR=/path/to/tile/cache

# Optional: CARTO basemap key. The default Esri dark basemap is keyless;
# CARTO dark_all/dark_nolabels watermark without a key.
#ARGUS_CARTO_KEY=your_carto_key
